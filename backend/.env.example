# Bu dosyayı backend/.env olarak kopyalayın (paketlenmiş uygulamada %APPDATA%/CyberGoose/.env).
# Yalnızca kullandığınız sağlayıcıların değerlerini doldurun. Gerçek anahtarları Git'e eklemeyin.

# Dropbox OAuth uygulaması (https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:5000/oauth2/callback
DROPBOX_TOKEN_FILE=dropboxtoken.json

# Google Drive OAuth (Google Cloud Console > OAuth istemcisi > Masaüstü uygulaması)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Yerel API (geliştirme)
FLASK_HOST=127.0.0.1
FLASK_PORT=5502
FLASK_DEBUG=false

# Veri klasörü: veritabanı ve token dosyaları. Boşsa backend/ klasörü kullanılır.
# CYBERGOOSE_DATA_DIR=
