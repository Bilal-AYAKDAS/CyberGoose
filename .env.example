# Copy this file to .env and fill in values for the providers you use.

# Dropbox OAuth application
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:5000/oauth2/callback
DROPBOX_TOKEN_FILE=dropboxtoken.json

# Google Drive OAuth
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Flask development settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5502
FLASK_DEBUG=false
